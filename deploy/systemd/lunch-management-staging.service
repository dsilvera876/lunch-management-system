[Unit]
Description=Lunch Management System (Staging)
Documentation=file:///var/www/lunch-management-system/deploy/STAGING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lunchapp
Group=lunchapp
WorkingDirectory=/var/www/lunch-management-system

# Secrets and runtime configuration live outside the repository.
EnvironmentFile=/etc/lunch-management/staging.env

# Bind only on localhost; Apache terminates public HTTP/HTTPS and proxies inbound traffic.
# Do not rely on HOSTNAME/PORT env vars — Next.js 16 requires explicit CLI flags.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/lunch-management-system

[Install]
WantedBy=multi-user.target
