[Unit]
Description=Periodic automatic late-order supplemental dispatch polling
Documentation=file:///var/www/lunch-management-system/deploy/STAGING.md
Requires=lunch-management-late-orders-worker.service

[Timer]
OnCalendar=*-*-* *:*:00 America/Jamaica
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
