[Unit]
Description=Lunch Management HR bulk user import worker
Documentation=file:///var/www/lunch-management-system/deploy/STAGING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lunchapp
Group=lunchapp
WorkingDirectory=/var/www/lunch-management-system
EnvironmentFile=/etc/lunch-management/worker.env
RuntimeDirectory=lunch-management-user-import
RuntimeDirectoryMode=0750
# Serialize activations: skip if a previous oneshot is still holding the lock.
ExecStart=/usr/bin/flock -n /run/lunch-management-user-import/import.lock /usr/bin/npm run worker:user-import
SuccessExitStatus=1
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/lunch-management-system

[Install]
WantedBy=multi-user.target
