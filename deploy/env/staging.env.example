# Copy to the server as /etc/lunch-management/staging.env
# Replace placeholder values. Do not commit real credentials.
#
# Recommended permissions:
#   sudo chown root:lunchapp /etc/lunch-management/staging.env
#   sudo chmod 640 /etc/lunch-management/staging.env
#
# Do NOT set NODE_ENV here. Next.js sets NODE_ENV automatically for
# `npm run build` and `npm run start`. Forcing NODE_ENV=production in this
# file can break builds (for example: Cannot find module '@tailwindcss/postcss').
#
# Bind address and port are configured in the systemd unit, not here.
#
# Required — Supabase project (hosted externally)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
#
# Required on staging/production — server-only public origin for auth redirects.
# Must match the browser-visible HTTPS URL (scheme + host, no trailing slash).
# Also configure Supabase Auth redirect URLs — see deploy/STAGING.md section 11.
APP_ORIGIN=https://STAGING_HOSTNAME
#
# Required when Supabase Send Email hook is enabled (Auth → Hooks).
# Must match the hook secret configured in Supabase Auth.
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_base64_hook_secret
#
# SMTP provider settings (host, credentials, From) are configured in the app:
# Admin → Settings → Email delivery (Vault-backed). Not in this file.
#
# Do NOT place SUPABASE_SECRET_KEY in this file. Use /etc/lunch-management/worker.env
# for background workers only.
