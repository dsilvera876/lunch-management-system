# Copy to the server as /etc/lunch-management/worker.env
# Background workers ONLY — do not load this file into the Next.js web service.
#
# Recommended permissions:
#   sudo chown root:lunchapp /etc/lunch-management/worker.env
#   sudo chmod 640 /etc/lunch-management/worker.env
#
# Required — Supabase project URL and Secret API key (sb_secret_...)
# Hosted: Project Settings → API → Secret key
# Local:  `supabase status` → Secret key (not the legacy service_role JWT)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key
#
# Required — SMTP2Go for automatic supplemental dispatch
SMTP2GO_API_KEY=your_smtp2go_api_key
SMTP2GO_SENDER=orders@your-domain.example
