# Copy to the server as /etc/lunch-management/worker.env
# Background workers ONLY — do not load this file into the Next.js web service.
#
# Recommended permissions:
#   sudo chown root:lunchapp /etc/lunch-management/worker.env
#   sudo chmod 640 /etc/lunch-management/worker.env
#
# Required — Supabase project URL and Secret API key (sb_secret_...)
# Hosted: Project Settings → API → Secret key
# Local:  `supabase status` → Secret key (not the legacy service_role JWT)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key
#
# Supplemental dispatch and Auth email queue delivery use Admin → Email delivery
# settings (loaded via service role + Vault). No separate SMTP environment variables.
#
# Run the mail queue worker on a timer (see deploy/systemd/lunch-management-mail-queue.timer)
# so Supabase Send Email hooks can enqueue quickly and SMTP sends happen in the background.
#
# Required for Today''s Menu and staff order notification bodies (order links):
APP_ORIGIN=https://STAGING_HOSTNAME
#
# Run the Today''s Menu notification worker every minute:
# deploy/systemd/lunch-management-today-menu-notifications.timer
