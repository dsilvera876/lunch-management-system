# Copy to /etc/lunch-management/web-privileged.env. Never commit a real value.
# Keep this separate from browser-visible and general web configuration.
#
# Recommended permissions:
#   sudo chown root:lunchapp /etc/lunch-management/web-privileged.env
#   sudo chmod 640 /etc/lunch-management/web-privileged.env
#
# Use a dedicated, independently revocable Supabase Secret key for the web
# server's signed Auth hook queueing, HR account-setup recovery initiation,
# and token-bound onboarding completion. Never prefix this variable NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_dedicated_web_key

# Independent HMAC key for short-lived HR account-setup purpose envelopes.
# Generate at least 32 random bytes on the server. Never reuse a Supabase key.
# This intentionally invalid placeholder must be replaced before deployment.
ACCOUNT_SETUP_RECOVERY_PURPOSE_SECRET=CHANGE_ME
