NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only public origin for auth redirects behind a reverse proxy.
# Required on staging/production (must match Supabase Site URL).
# Omit for local development (forwarded headers / Host are used instead).
# APP_ORIGIN=http://localhost:3000
#
# Password recovery: local dev validates via lint/build/DB/unit tests only.
# End-to-end reset email acceptance is tested on staging (see deploy/STAGING.md).
